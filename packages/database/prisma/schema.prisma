generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}


datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  TOURNAMENT_ADMIN
  SCORER
  VIEWER
}

enum PlayerRole {
  BATTER
  BOWLER
  ALL_ROUNDER
  WICKET_KEEPER
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  SCHEDULED
  LIVE
  KNOCKOUT
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  UPCOMING
  LIVE
  COMPLETED
  ABANDONED
}

enum InningsStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ExtraType {
  NONE
  WIDE
  NO_BALL
  BYE
  LEG_BYE
}

enum WicketType {
  BOWLED
  CAUGHT
  LBW
  RUN_OUT
  STUMPED
  HIT_WICKET
  TIMED_OUT
  RETIRED_HURT
  RETIRED_OUT
  HIT_BALL_TWICE
  OBSTRUCTING_FIELD
  OTHER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id              String            @id @default(uuid())
  name            String
  shortName       String
  logoUrl         String?
  city            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  teamPlayers     TeamPlayer[]
  tournamentTeams TournamentTeam[]
  tournamentSquads TournamentSquad[]
  matchesAsTeamA  Match[]           @relation("MatchTeamA")
  matchesAsTeamB  Match[]           @relation("MatchTeamB")
  matchesTossWon  Match[]           @relation("MatchTossWinner")
  matchesWon      Match[]           @relation("MatchWinner")
  battingInnings  Innings[]         @relation("InningsBattingTeam")
  bowlingInnings  Innings[]         @relation("InningsBowlingTeam")
  drawCaptainOrders TournamentDrawCaptainOrder[]
  drawSelectedChits TournamentDrawChit[]
  drawAudits        TournamentDrawAudit[]
}

model Player {
  id                  String            @id @default(uuid())
  name                String
  indexNumber         String?
  profileImageUrl     String?
  dateOfBirth         DateTime?
  role                PlayerRole        @default(BATTER)
  battingStyle        String?
  bowlingStyle        String?
  jerseyNumber        Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  teamPlayers         TeamPlayer[]
  tournamentSquads    TournamentSquad[]
  strikerInnings      Innings[]         @relation("InningsCurrentStriker")
  nonStrikerInnings   Innings[]         @relation("InningsCurrentNonStriker")
  bowlerInnings       Innings[]         @relation("InningsCurrentBowler")
  batsmanDeliveries   BallEvent[]       @relation("BallBatsman")
  bowlerDeliveries    BallEvent[]       @relation("BallBowler")
  dismissedDeliveries BallEvent[]       @relation("BallDismissedPlayer")
  battingScores       InningsBatter[]
  bowlingScores       InningsBowler[]

  @@index([indexNumber])
}

model TeamPlayer {
  id        String   @id @default(uuid())
  teamId    String
  playerId  String
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id])
  player    Player   @relation(fields: [playerId], references: [id])

  @@unique([teamId, playerId])
}

model Tournament {
  id                     String                  @id @default(uuid())
  name                   String
  season                 String
  format                 String
  status                 TournamentStatus        @default(DRAFT)
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  stages                 TournamentStage[]
  tournamentTeams        TournamentTeam[]
  tournamentSquads       TournamentSquad[]
  registrations          Registration[]
  registrationExceptions RegistrationException[]
  matches                Match[]
  draws                  TournamentDraw[]
}

model TournamentStage {
  id                 String     @id @default(uuid())
  tournamentId       String
  name               String
  stageOrder         Int
  oversPerInnings    Int
  ballsPerOver       Int        @default(6)
  pointsForWin       Int        @default(2)
  pointsForTie       Int        @default(1)
  pointsForNoResult  Int        @default(1)
  pointsForLoss      Int        @default(0)
  qualificationCount Int?
  tournament         Tournament @relation(fields: [tournamentId], references: [id])
}

model TournamentTeam {
  id               String     @id @default(uuid())
  tournamentId     String
  teamId           String
  matchesPlayed    Int        @default(0)
  wins             Int        @default(0)
  losses           Int        @default(0)
  ties             Int        @default(0)
  noResults        Int        @default(0)
  points           Int        @default(0)
  runsFor          Int        @default(0)
  legalBallsFaced  Int        @default(0)
  runsAgainst      Int        @default(0)
  legalBallsBowled Int        @default(0)
  groupName        String?
  seed             Int?
  stage            String?
  qualificationStatus String?
  nrr              Float?     @default(0)
  tournament       Tournament @relation(fields: [tournamentId], references: [id])
  team             Team       @relation(fields: [teamId], references: [id])

  @@unique([tournamentId, teamId])
  @@index([tournamentId, groupName])
}

model TournamentSquad {
  id           String     @id @default(uuid())
  tournamentId String
  teamId       String
  playerId     String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  team         Team       @relation(fields: [teamId], references: [id])
  player       Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, teamId, playerId])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BackupStatus {
  PENDING
  SYNCED
  FAILED
}

model Registration {
  id                String             @id @default(uuid())
  registrationCode  String             @unique
  tournamentId      String
  tournament        Tournament         @relation(fields: [tournamentId], references: [id])
  teamName          String
  leaderName        String
  leaderWhatsapp    String
  leaderIndexNumber String
  status            RegistrationStatus @default(PENDING)

  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?

  backupStatus      BackupStatus @default(PENDING)
  backupError       String?
  backupLastAttempt DateTime?
  backupSyncedAt    DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players RegistrationPlayer[]

  @@index([tournamentId])
  @@index([tournamentId, status])
  @@index([tournamentId, leaderIndexNumber])
}

model RegistrationPlayer {
  id             String       @id @default(uuid())
  registrationId String
  name           String
  indexNumber    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([indexNumber])
}

model RegistrationException {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  name         String?
  teamName     String?
  indexPrefix  String?
  minPlayers   Int        @default(7)
  active       Boolean    @default(true)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tournamentId])
  @@index([active])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  description String?
  performedBy String   @default("ADMIN")
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model Match {
  id              String       @id @default(uuid())
  tournamentId    String
  tournament      Tournament   @relation(fields: [tournamentId], references: [id])
  teamAId         String
  teamA           Team         @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamBId         String
  teamB           Team         @relation("MatchTeamB", fields: [teamBId], references: [id])
  venue           String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  status          MatchStatus  @default(UPCOMING)
  currentInnings  Int          @default(1)
  oversPerInnings Int          @default(20)
  ballsPerOver    Int          @default(6)
  tossWinnerId    String?
  tossWinner      Team?        @relation("MatchTossWinner", fields: [tossWinnerId], references: [id])
  tossDecision    String?
  winnerTeamId    String?
  winnerTeam      Team?        @relation("MatchWinner", fields: [winnerTeamId], references: [id])
  resultNote      String?
  stage           String?
  groupName       String?
  matchNumber     Int?
  bracketSlot     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  innings         Innings[]

  @@index([tournamentId])
  @@index([status])
  @@index([teamAId])
  @@index([teamBId])
  @@index([tournamentId, stage])
  @@index([tournamentId, groupName])
}

model Innings {
  id                  String          @id @default(uuid())
  matchId             String
  match               Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  inningsNumber       Int
  battingTeamId       String
  battingTeam         Team            @relation("InningsBattingTeam", fields: [battingTeamId], references: [id])
  bowlingTeamId       String
  bowlingTeam         Team            @relation("InningsBowlingTeam", fields: [bowlingTeamId], references: [id])
  runs                Int             @default(0)
  wickets             Int             @default(0)
  overs               Int             @default(0)
  balls               Int             @default(0)
  isAllOut            Boolean         @default(false)
  maxWickets          Int?
  status              InningsStatus   @default(NOT_STARTED)
  currentStrikerId    String?
  currentStriker      Player?         @relation("InningsCurrentStriker", fields: [currentStrikerId], references: [id])
  currentNonStrikerId String?
  currentNonStriker   Player?         @relation("InningsCurrentNonStriker", fields: [currentNonStrikerId], references: [id])
  currentBowlerId     String?
  currentBowler       Player?         @relation("InningsCurrentBowler", fields: [currentBowlerId], references: [id])
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  ballEvents          BallEvent[]
  battingScores       InningsBatter[]
  bowlingScores       InningsBowler[]

  @@unique([matchId, inningsNumber])
  @@index([matchId])
  @@index([status])
}

model BallEvent {
  id                 String      @id @default(uuid())
  inningsId          String
  innings            Innings     @relation(fields: [inningsId], references: [id], onDelete: Cascade)
  overNumber         Int
  ballNumber         Int
  batsmanId          String
  batsman            Player      @relation("BallBatsman", fields: [batsmanId], references: [id])
  bowlerId           String
  bowler             Player      @relation("BallBowler", fields: [bowlerId], references: [id])
  runs               Int         @default(0)
  extras             Int         @default(0)
  extraType          ExtraType   @default(NONE)
  byeRuns            Int         @default(0)
  legByeRuns         Int         @default(0)
  isLegal            Boolean     @default(true)
  isWicket           Boolean     @default(false)
  wicketType         WicketType?
  dismissedPlayerId  String?
  dismissedPlayer    Player?     @relation("BallDismissedPlayer", fields: [dismissedPlayerId], references: [id])
  commentary         String?
  strikerIdBefore    String?
  nonStrikerIdBefore String?
  bowlerIdBefore     String?
  createdAt          DateTime    @default(now())

  @@index([inningsId])
  @@index([inningsId, overNumber])
  @@index([createdAt])
}

model InningsBatter {
  id           String    @id @default(uuid())
  inningsId    String
  innings      Innings   @relation(fields: [inningsId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player    @relation(fields: [playerId], references: [id])
  runs         Int       @default(0)
  balls        Int       @default(0)
  fours        Int       @default(0)
  sixes        Int       @default(0)
  dismissal    String?
  isOut        Boolean   @default(false)
  isStriker    Boolean   @default(false)
  battingOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([inningsId, playerId])
  @@index([inningsId])
}

model InningsBowler {
  id           String    @id @default(uuid())
  inningsId    String
  innings      Innings   @relation(fields: [inningsId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player    @relation(fields: [playerId], references: [id])
  overs        Int       @default(0)
  balls        Int       @default(0)
  maidens      Int       @default(0)
  runsConceded Int       @default(0)
  wickets      Int       @default(0)
  wides        Int       @default(0)
  noBalls      Int       @default(0)
  isCurrent    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([inningsId, playerId])
  @@index([inningsId])
}

enum TournamentDrawStatus {
  DRAFT
  READY
  IN_PROGRESS
  PAUSED
  COMPLETED
  FINALIZED
  CANCELLED
}

model TournamentDraw {
  id               String                       @id @default(uuid())
  tournamentId     String
  status           TournamentDrawStatus         @default(DRAFT)
  currentPickIndex Int                          @default(0)
  commitmentHash   String?
  secretSalt       String?
  createdAt        DateTime                     @default(now())
  startedAt        DateTime?
  pausedAt         DateTime?
  completedAt      DateTime?
  finalizedAt      DateTime?
  createdBy        String?
  tournament       Tournament                   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  captainOrders    TournamentDrawCaptainOrder[]
  chits            TournamentDrawChit[]
  auditLogs        TournamentDrawAudit[]

  @@index([tournamentId, status])
}

model TournamentDrawCaptainOrder {
  id           String         @id @default(uuid())
  drawId       String
  position     Int
  teamId       String
  captainName  String
  passcodeHash String
  createdAt    DateTime       @default(now())
  draw         TournamentDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([drawId, position])
  @@unique([drawId, teamId])
  @@index([drawId])
}

model TournamentDrawChit {
  id               String         @id @default(uuid())
  drawId           String
  position         Int
  groupName        String
  isRevealed       Boolean        @default(false)
  selectedByTeamId String?
  selectedAt       DateTime?
  draw             TournamentDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  selectedByTeam   Team?          @relation(fields: [selectedByTeamId], references: [id])

  @@unique([drawId, position])
  @@unique([drawId, selectedByTeamId])
  @@index([drawId])
}

model TournamentDrawAudit {
  id           String         @id @default(uuid())
  drawId       String
  eventType    String
  teamId       String?
  captainId    String?
  chitPosition Int?
  groupName    String?
  actor        String?
  description  String?
  metadata     Json?
  createdAt    DateTime       @default(now())
  draw         TournamentDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  team         Team?          @relation(fields: [teamId], references: [id])

  @@index([drawId, createdAt])
}

model ScoringOperation {
  id          String   @id @default(uuid())
  operationId String   @unique
  matchId     String
  inningsId   String
  status      String   @default("PROCESSED")
  result      Json?
  clientId    String?
  createdAt   DateTime @default(now())
  processedAt DateTime @default(now())

  @@index([matchId])
  @@index([inningsId])
}
